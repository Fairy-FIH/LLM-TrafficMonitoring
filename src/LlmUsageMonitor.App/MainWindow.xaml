<ui:FluentWindow x:Class="LlmUsageMonitor.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:LlmUsageMonitor.App.ViewModels"
                 Title="LLM用量统计"
                 Width="1280" Height="840"
                 MinWidth="1080" MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="LLM用量统计" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Grid.Column="0" Background="{DynamicResource App.Card}"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,1,0">
                <Grid Margin="8,10,8,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="10,4,10,14">
                        <TextBlock Text="LLM用量统计" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text}" />
                        <TextBlock Text="多平台 API 用量 · 实时计费" Style="{StaticResource Caption}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavItem}">
                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="2" Margin="2,10,2,0">
                        <Border Background="{DynamicResource App.CardAlt}" CornerRadius="8" Padding="10,8" Margin="4,0,4,8">
                            <StackPanel>
                                <TextBlock Text="{Binding ProxyBadge}" FontSize="12"
                                           Foreground="{DynamicResource App.SubText}" />
                                <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="3" Margin="2,0">
                            <Button Command="{Binding CycleCurrencyCommand}" Content="{Binding CurrencyLabel}"
                                    Margin="2" ToolTip="切换显示币种" />
                            <Button Command="{Binding ToggleThemeCommand}" Content="{Binding ThemeLabel}"
                                    Margin="2" ToolTip="切换深浅色主题" />
                            <Button Command="{Binding RefreshAllCommand}" Content="同步"
                                    Margin="2" ToolTip="刷新定价并同步用量" />
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page host -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentControl Grid.Row="0" Content="{Binding CurrentViewModel}" Margin="20,16,20,8" />
                <Border Grid.Row="1" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0"
                        Padding="20,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CurrencyLabel}"
                                   Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
