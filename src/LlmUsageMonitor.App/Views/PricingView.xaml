<UserControl x:Class="LlmUsageMonitor.App.Views.PricingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="联网刷新定价" Command="{Binding RefreshSourcesCommand}"
                    Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="新增手工定价" Command="{Binding AddBlankCommand}" />
            <StackPanel>
                <TextBlock Text="模型定价" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0" Padding="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding LoadCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <ComboBox Grid.Column="1" Width="150" ItemsSource="{Binding ProviderFilters}"
                                  SelectedItem="{Binding SelectedProviderFilter}" DisplayMemberPath="Label" />
                    </Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0"
                              RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="模型名" Width="*" Binding="{Binding Model}" />
                            <DataGridTextColumn Header="输入/1M" Width="90"
                                Binding="{Binding InputPerMillion, StringFormat={}{0:0.####}}" />
                            <DataGridTextColumn Header="输出/1M" Width="90"
                                Binding="{Binding OutputPerMillion, StringFormat={}{0:0.####}}" />
                            <DataGridTextColumn Header="缓存/1M" Width="90"
                                Binding="{Binding CachedInputPerMillion, StringFormat={}{0:0.####}}" />
                            <DataGridTextColumn Header="币种" Width="60" Binding="{Binding Currency}" />
                            <DataGridTextColumn Header="来源" Width="90" Binding="{Binding Source}" />
                            <DataGridCheckBoxColumn Header="手工" Width="50" Binding="{Binding IsManual}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16"
                    Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibility}}">
                <StackPanel>
                    <TextBlock Text="手工定价" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="{Binding SelectedItem.Provider, StringFormat=平台：{0}}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="{Binding SelectedItem.Model, StringFormat=模型：{0}}" />

                    <TextBlock Text="输入价格 / 1M" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                    <TextBox Text="{Binding EditInput, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="输出价格 / 1M" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding EditOutput, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="缓存输入价格 / 1M（可空）" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding EditCached, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="币种" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding EditCurrency}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="保存为手工定价" Command="{Binding SaveManualCommand}" Margin="0,0,8,0" />
                        <Button Content="删除" Command="{Binding DeleteCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="手工定价始终优先，不会被在线刷新覆盖。单位：每 100 万 token。" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
