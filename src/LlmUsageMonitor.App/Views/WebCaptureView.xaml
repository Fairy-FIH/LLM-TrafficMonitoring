<UserControl x:Class="LlmUsageMonitor.App.Views.WebCaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="网页登录抓取" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="在下方内置浏览器中登录平台控制台并打开“用量/账单”页，程序会拦截页面返回的 JSON，自动识别用量并导入（会话会保留，无需重复登录）。" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="平台" Style="{StaticResource Caption}" />
                    <ComboBox Width="150" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                              DisplayMemberPath="Label" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="地址" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding NavigationUrl, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Button Grid.Column="2" Content="打开" Command="{Binding NavigateCommand}" Margin="0,0,6,0"
                        VerticalAlignment="Bottom" />
                <Button Grid.Column="3" Content="刷新" Command="{Binding ReloadCommand}" Margin="0,0,6,0"
                        VerticalAlignment="Bottom" />
                <Button Grid.Column="4" Content="外部浏览器" Command="{Binding OpenExternalCommand}"
                        VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="1" Margin="0,0,10,0">
                <Grid>
                    <wv2:WebView2 x:Name="Browser" />
                    <Border x:Name="Overlay" Background="{DynamicResource App.Card}" Padding="24">
                        <TextBlock x:Name="OverlayText" Text="正在初始化内置浏览器…"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox Content="自动导入识别到的用量" IsChecked="{Binding AutoImport}" />
                        <TextBlock Text="{Binding CapturedCountText}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ImportedCountText}" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource App.Accent}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListBox Grid.Row="0" ItemsSource="{Binding Candidates}"
                                 SelectedItem="{Binding SelectedCandidate}" Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,3">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" CornerRadius="6" Padding="6,1"
                                                    Background="{DynamicResource App.AccentSoft}">
                                                <TextBlock Text="{Binding Summary}" FontSize="10"
                                                           Foreground="{DynamicResource App.Accent}" />
                                            </Border>
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding ShortUrl}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource App.Text}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="1" Background="{DynamicResource App.CardAlt}" CornerRadius="8"
                                Margin="0,8,0,0" Padding="8">
                            <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="11" MaxHeight="220"
                                     TextWrapping="NoWrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Background="Transparent" BorderThickness="0" />
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="导入选中" Command="{Binding ImportSelectedCommand}" Margin="0,0,8,0" />
                    <Button Content="清空捕获" Command="{Binding ClearCommand}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
