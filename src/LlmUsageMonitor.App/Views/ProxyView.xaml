<UserControl x:Class="LlmUsageMonitor.App.Views.ProxyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="本地代理" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="内置 OpenAI / Anthropic 兼容转发服务，用于精确统计请求数、输入/输出 Token 并即时计费。" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource AccentCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="服务状态" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding StateText}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource App.Accent}" />
                        <TextBlock Text="{Binding EndpointText}" FontFamily="Consolas" Margin="0,4,0,10"
                                   Foreground="{DynamicResource App.Text}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="启动 / 停止" Command="{Binding ToggleCommand}" Width="120"
                                    Margin="0,0,8,0" />
                            <Button Content="打开外部浏览器" Command="{Binding OpenBrowserCommand}" Width="140" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="今日经代理统计" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding CapturedTodayText}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PortText, StringFormat=监听端口：{0}}" Style="{StaticResource Caption}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="端口与访问令牌可在“设置”页调整。" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="默认上游（未配置密钥时使用，透传客户端自带的 Key）"
                               Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="平台" Style="{StaticResource Caption}" />
                            <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding DefaultProvider}"
                                      DisplayMemberPath="Label" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="上游 Base URL" Style="{StaticResource Caption}" />
                            <TextBox Text="{Binding DefaultBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="透传客户端 Authorization（推荐）" IsChecked="{Binding PassThroughAuth}"
                              Margin="0,10,0,0" />
                    <Button Content="保存上游设置" Command="{Binding SaveUpstreamCommand}" Margin="0,10,0,0"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="使用说明" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Instructions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4"
                                           Foreground="{DynamicResource App.SubText}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
