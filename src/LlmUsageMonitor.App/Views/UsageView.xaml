<UserControl x:Class="LlmUsageMonitor.App.Views.UsageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="删除当前筛选" Command="{Binding DeleteFilteredCommand}"
                    Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="清空全部" Command="{Binding ClearAllCommand}" />
            <StackPanel>
                <TextBlock Text="用量明细" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="时间范围" Style="{StaticResource Caption}" />
                    <ComboBox Width="120" ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}"
                              DisplayMemberPath="Label" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="平台" Style="{StaticResource Caption}" />
                    <ComboBox Width="150" ItemsSource="{Binding ProviderOptions}"
                              SelectedItem="{Binding SelectedProvider}" DisplayMemberPath="Label" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="来源" Style="{StaticResource Caption}" />
                    <ComboBox Width="130" ItemsSource="{Binding SourceOptions}"
                              SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Label" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="模型过滤" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding ModelFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="0,0,10,0">
                    <TextBlock Text="请求数" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding RequestsText}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text}" />
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="0,0,10,0">
                    <TextBlock Text="总 Token" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding TokensText}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text}" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="总花费" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding CostText}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Accent}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" GridLinesVisibility="Horizontal" Background="Transparent"
                      BorderThickness="0" RowHeight="30">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Width="150" Binding="{Binding TimeText}" />
                    <DataGridTextColumn Header="平台" Width="120" Binding="{Binding ProviderText}" />
                    <DataGridTextColumn Header="模型" Width="*" Binding="{Binding Model}" />
                    <DataGridTextColumn Header="来源" Width="90" Binding="{Binding SourceText}" />
                    <DataGridTextColumn Header="输入 Token" Width="110"
                        Binding="{Binding InputTokens, StringFormat=N0}" />
                    <DataGridTextColumn Header="输出 Token" Width="110"
                        Binding="{Binding OutputTokens, StringFormat=N0}" />
                    <DataGridTextColumn Header="缓存 Token" Width="110"
                        Binding="{Binding CachedTokens, StringFormat=N0}" />
                    <DataGridTextColumn Header="请求" Width="80" Binding="{Binding Requests, StringFormat=N0}" />
                    <DataGridTextColumn Header="花费" Width="110" Binding="{Binding CostText}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
