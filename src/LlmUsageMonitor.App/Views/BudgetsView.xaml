<UserControl x:Class="LlmUsageMonitor.App.Views.BudgetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="立即检查预算" Command="{Binding EvaluateCommand}"
                    Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="新建规则" Command="{Binding NewRuleCommand}" />
            <StackPanel>
                <TextBlock Text="预算告警" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="预算规则（全局）" Style="{StaticResource SectionTitle}" />
                    <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0"
                              RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="周期" Width="90" Binding="{Binding PeriodText}" />
                            <DataGridTextColumn Header="限额" Width="130" Binding="{Binding LimitText}" />
                            <DataGridTextColumn Header="阈值" Width="*" Binding="{Binding ThresholdsText}" />
                            <DataGridCheckBoxColumn Header="启用" Width="60" Binding="{Binding Enabled}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="编辑规则" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="周期" Style="{StaticResource Caption}" />
                        <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding EditPeriod}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0">
                            <Run Text="预算限额（" /><Run Text="{Binding CurrencySymbol}" /><Run Text="）" />
                        </TextBlock>
                        <TextBox Text="{Binding EditLimit, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="告警阈值（逗号分隔，如 80,100）" Style="{StaticResource Caption}"
                                   Margin="0,8,0,0" />
                        <TextBox Text="{Binding EditThresholds, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="保存" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
                            <Button Content="删除" Command="{Binding DeleteCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <TextBlock Text="告警记录" Style="{StaticResource SectionTitle}" />
                            <Button HorizontalAlignment="Right" Content="清空" Command="{Binding ClearAlertsCommand}" />
                        </Grid>
                        <ListBox ItemsSource="{Binding Alerts}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LevelText}"
                                                       Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource App.Text}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                   Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
