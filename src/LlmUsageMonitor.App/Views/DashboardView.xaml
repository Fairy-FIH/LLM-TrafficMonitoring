<UserControl x:Class="LlmUsageMonitor.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:LlmUsageMonitor.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,14">
                <ComboBox DockPanel.Dock="Right" Width="130" ItemsSource="{Binding Ranges}"
                          SelectedItem="{Binding Range}" DisplayMemberPath="Label" />
                <StackPanel>
                    <TextBlock Text="仪表盘" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
                </StackPanel>
            </DockPanel>

            <!-- Stat cards -->
            <UniformGrid Rows="1" Columns="5" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="请求次数" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding RequestsText}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="输入 Token" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding InputTokensText}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="输出 Token" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding OutputTokensText}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="总 Token" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding TotalTokensText}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource AccentCard}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="总花费" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding CostText}" Style="{StaticResource StatValue}"
                                   Foreground="{DynamicResource App.Accent}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Charts -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="花费趋势" Style="{StaticResource SectionTitle}" />
                        <ctrl:LineChart Height="230" Items="{Binding DailyPoints}"
                                        LineBrush="{DynamicResource App.Accent}"
                                        TextBrush="{DynamicResource App.SubText}"
                                        Symbol="{Binding CurrencySymbol}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="平台分布" Style="{StaticResource SectionTitle}" />
                        <ctrl:DonutChart Height="150" Items="{Binding ProviderSlices}"
                                         AccentBrush="{DynamicResource App.Accent}"
                                         TextBrush="{DynamicResource App.Text}"
                                         Symbol="{Binding CurrencySymbol}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding ProviderSlices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding DisplayText}"
                                                       Margin="8,0,0,0" FontSize="12"
                                                       Foreground="{DynamicResource App.SubText}" />
                                            <Ellipse DockPanel.Dock="Left" Width="10" Height="10"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                            <TextBlock Text="{Binding Label}" Margin="6,0,0,0" FontSize="12"
                                                       Foreground="{DynamicResource App.Text}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Model ranking + recent -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="模型花费排行" Style="{StaticResource SectionTitle}" />
                        <ctrl:BarChart Height="240" Items="{Binding ModelSlices}"
                                       AccentBrush="{DynamicResource App.Accent}"
                                       TextBrush="{DynamicResource App.Text}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="最近记录" Style="{StaticResource SectionTitle}" />
                        <DataGrid ItemsSource="{Binding RecentRecords}" AutoGenerateColumns="False"
                                  IsReadOnly="True" MaxHeight="240" HeadersVisibility="Column"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  Background="Transparent" BorderThickness="0" RowHeight="28">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Width="120"
                                    Binding="{Binding Timestamp, StringFormat=MM-dd HH:mm}" />
                                <DataGridTextColumn Header="平台" Width="110"
                                    Binding="{Binding Provider, Converter={StaticResource ProviderToText}}" />
                                <DataGridTextColumn Header="模型" Width="*" Binding="{Binding Model}" />
                                <DataGridTextColumn Header="输入" Width="70"
                                    Binding="{Binding InputTokens, StringFormat=N0}" />
                                <DataGridTextColumn Header="输出" Width="70"
                                    Binding="{Binding OutputTokens, StringFormat=N0}" />
                                <DataGridTextColumn Header="花费" Width="80"
                                    Binding="{Binding CostUsd, StringFormat=¥{0:0.####}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
