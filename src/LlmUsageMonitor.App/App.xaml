<Application x:Class="LlmUsageMonitor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:LlmUsageMonitor.App.Converters"
             xmlns:vm="clr-namespace:LlmUsageMonitor.App.ViewModels"
             xmlns:views="clr-namespace:LlmUsageMonitor.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NotNullToVisibility" Inverse="True" />
            <conv:ProviderToTextConverter x:Key="ProviderToText" />
            <conv:SourceToTextConverter x:Key="SourceToText" />
            <conv:LogLevelToBrushConverter x:Key="LogLevelToBrush" />

            <!-- Fallback palette; ThemeManager overwrites these at runtime. -->
            <SolidColorBrush x:Key="App.Background" Color="#0F1115" />
            <SolidColorBrush x:Key="App.Card" Color="#171A21" />
            <SolidColorBrush x:Key="App.CardAlt" Color="#1E222C" />
            <SolidColorBrush x:Key="App.Border" Color="#2A303C" />
            <SolidColorBrush x:Key="App.Text" Color="#F3F6FB" />
            <SolidColorBrush x:Key="App.SubText" Color="#9AA4B2" />
            <SolidColorBrush x:Key="App.Accent" Color="#4F8CFF" />
            <SolidColorBrush x:Key="App.AccentSoft" Color="#294F8CFF" />
            <SolidColorBrush x:Key="App.NavSelected" Color="#384F8CFF" />

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource App.SubText}" />
            </Style>

            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource App.Card}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="AccentCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="NavButton" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Margin" Value="6,2" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Root" Background="Transparent" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background"
                                            Value="{DynamicResource App.CardAlt}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Root" Property="Background"
                                            Value="{DynamicResource App.NavSelected}" />
                                    <Setter TargetName="Root" Property="BorderBrush"
                                            Value="{DynamicResource App.Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UsageViewModel}">
                <views:UsageView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WebCaptureViewModel}">
                <views:WebCaptureView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PricingViewModel}">
                <views:PricingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BudgetsViewModel}">
                <views:BudgetsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProxyViewModel}">
                <views:ProxyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ExportViewModel}">
                <views:ExportView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogsViewModel}">
                <views:LogsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
